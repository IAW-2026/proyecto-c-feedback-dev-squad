generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id         String   @id @default(uuid())
  tipo       String
  targetId   String
  targetName String?
  sellerName String?
  userId     String
  userName   String?
  rating     Int
  comentario String
  estado     String   @default("published")
  fecha      DateTime @default(now())
  reports    Report[]
}

model Report {
  id           String   @id @default(uuid())
  reviewId     String
  reporterId   String
  reporterName String?
  razon        String
  resuelto     Boolean  @default(false)
  resolvedBy   String?
  adminComment String?
  fecha        DateTime @default(now())
  review       Review   @relation(fields: [reviewId], references: [id])
}
